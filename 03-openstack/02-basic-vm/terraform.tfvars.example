# Example Terraform variables file
# Copy this to terraform.tfvars and customize for your environment

# Instance configuration
instance_name = "my-terraform-vm"
key_name      = "my-terraform-key"

# OpenStack resource names (adjust to match your environment)
flavor_name  = "m1.small"     # or "small", "standard.small", etc.
image_name   = "Ubuntu 22.04" # or "ubuntu-22.04", "Ubuntu Server 22.04", etc.
network_name = "internal"     # or "private", "tenant-network", etc.

# Floating IP (set to true if you want external access)
create_floating_ip = false

# Common OpenStack flavor names you might find:
# - m1.tiny, m1.small, m1.medium, m1.large
# - standard.small, standard.medium
# - c1.small, c1.medium (compute optimized)
# - r1.small, r1.medium (memory optimized)

# Common OpenStack image names you might find:
# - "Ubuntu 22.04"
# - "ubuntu-22.04"
# - "Ubuntu Server 22.04 LTS"
# - "cirros-0.5.2-x86_64"

# Common OpenStack network names you might find:
# - "internal"
# - "private"
# - "tenant-network"
# - "default"